# Blast Radius Zero — runtime configuration.
# Installed as /opt/brz/.env (mode 0600, read by systemd, never by the sandbox).
# Every value here is a security-relevant default: tighten, don't loosen.

# --- Vultr Serverless Inference (OpenAI-compatible) -------------------------
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=glm-5.3
INFERENCE_TIMEOUT_S=90
# 0 = real model calls. 1 = deterministic stub, safe for demos without a key.
MOCK_INFERENCE=1

# --- Sandbox ---------------------------------------------------------------
SANDBOX_IMAGE=brz-sandbox:1
# auto = use gVisor when Docker has runsc, else fall back to runc.
# runsc = refuse to start a step unless gVisor is really there.
SANDBOX_RUNTIME=auto
# 256 MB is enough for numpy/pandas on small frames; matplotlib adds ~60 MB.
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_PIDS=64
SANDBOX_TMP_MB=16
# Artifact bytes allowed per step (watchdog-enforced, not a quota).
SANDBOX_DISK_MB=64
SANDBOX_TIMEOUT_S=20
SANDBOX_OUTPUT_BYTES=200000
# Keep "none". "bridge" gives the cell internet access and breaks containment.
SANDBOX_NETWORK=none

# --- Agent ----------------------------------------------------------------
MAX_STEPS=5
MAX_VERIFY_RETRIES=1
MAX_TASK_CHARS=4000

# --- Public-demo hardening ------------------------------------------------
RUNS_PER_HOUR=12
PROBES_PER_HOUR=20
MAX_CONCURRENT_RUNS=2

# --- Storage --------------------------------------------------------------
DATA_DIR=/opt/brz/data

# --- Reverse proxy (Caddy; read from the environment, not by the app) ------
# Use <public-ip>.sslip.io to get a real certificate without owning DNS.
BRZ_DOMAIN=
